generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Entry {
  id           String     @id @default(cuid())
  fullName     String
  jerseyName   String
  nameKey      String     @unique
  jerseyNumber Int
  jerseySize   JerseySize
  sleeve       Sleeve
  pantWaist    String
  pantLength   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([createdAt])
}

enum JerseySize {
  S
  M
  L
  XL
  XXL
}

enum Sleeve {
  HALF
  FULL
}
